# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL. Required when NODE_ENV=production. The docker-compose.yml defaults
# below use this connection string for local development.
DATABASE_URL=postgresql://rag:rag_local_password@localhost:5432/rag?schema=public

# Generate a different value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret

# Root directory for LanceDB data. Mount this path to persistent storage in production.
VECTOR_DATA_DIR=./vectors

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
# For Google AI Studio (Gemini), set LLM_BASE_URL to: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://openrouter.ai/api/v1


# Rate Limiting
RATE_LIMIT_MAX=100
CRAWL_MAX_PAGES=150
CRAWL_MAX_CONCURRENCY=2
CRAWL_TIMEOUT_MS=10000

# The legacy file-backed /reindex endpoint is for local migration only. It is
# disabled in production; database-backed indexing jobs will replace it.
ENABLE_LEGACY_REINDEX=false

# Security (Comma-separated allowed frontend domains)
ALLOWED_ORIGINS=https://yourwebsite.com,http://localhost:3000


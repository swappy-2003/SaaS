{
  "name": "ai-rag-backend",
  "version": "1.0.0",
  "description": "Multi-tenant AI RAG Backend using Fastify, LanceDB, Xenova Transformers, and OpenRouter",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "index": "tsx src/scripts/index.ts",
    "reindex": "tsx src/scripts/index.ts --reindex",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@clerk/fastify": "^1.0.51",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@lancedb/lancedb": "^0.13.0",
    "@prisma/client": "^6.19.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/xml2js": "^0.4.14",
    "prisma": "^6.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
